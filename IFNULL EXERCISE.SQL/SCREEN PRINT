---Create Catalog
CREATE CATALOG IF NOT EXISTS orders;


---Create Schema inside the catalog
CREATE SCHEMA IF NOT EXISTS orders.default;

---Create project table inside the schema
CREATE TABLE IF NOT EXISTS orders.default.excersize(
order_id INT,
customer_id INT,
delivery_date DATE
);

----Insert Values into table in order to start SQL scripts
INSERT INTO orders.default.excersize VALUES
(101,201,'2024-12-01'),
(102,202,NULL),
(103,NULL,'2024-12-03');

---CHECKING TABLE loaded correctly before coding
SELECT*
FROM orders.default.excersize;

--Q3. Find orders with NULL customer_id using ISNULL().
SELECT*
FROM orders.default.excersize
WHERE customer_id IS NULL;


--Q4. Show all orders. If delivery_date is NULL, show 'Pending'
