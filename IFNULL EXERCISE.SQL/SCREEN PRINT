-Advanced SQL NULL Functions

---Create Catalog
CREATE CATALOG IF NOT EXISTS Employees;

---Create Schema inside the catalog
CREATE SCHEMA IF NOT EXISTS Employees.Default;

---Create project table inside the schema
CREATE TABLE IF NOT EXISTS Employees.Default.Exercise (
employee_id INT,
Name_ STRING,
department STRING,
salary INT
);
--
----Insert Values into table in order to start SQL scripts
INSERT INTO Employees.Default.Exercise VALUES
(1,'Alice','HR','5000'),
(2,'Bob','IT',NULL),
(3,'Charlie',NULL,'7000'),
(4,'Dana','Finance',NULL);

SELECT*
FROM Employees.Default.Exercise;

--DROP TABLE Employees.Default.Exercise;

--Q1. Show all employees with their salary. If salary is NULL, display 0.
SELECT employee_id,
       Name_,
       department,
       IFNULL(salary,'0') AS salary_with_default
FROM Employees.Default.Exercise;

----Q2. Show employee names with their department. If department is NULL, show "Not Assigned".
SELECT employee_id,
       Name_,
       IFNULL(department,'Not Assigned') AS department_name
FROM Employees.Default.Exercise;

